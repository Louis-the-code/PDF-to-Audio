# ── Server-side secrets (never exposed to the browser) ──────────────────────
# Your Gemini API key. Only the Express server reads this; the browser talks to
# the server's /api routes instead. Do NOT prefix it with VITE_.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── Supabase (public values; safe to ship to the browser) ───────────────────
# Used by the app for sign-in/storage, and by the server to verify sign-in
# tokens before it will call Gemini on a user's behalf.
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ── Optional ────────────────────────────────────────────────────────────────
# PORT=3000
# Text extraction models, fastest first. If one isn't available to your key the
# next is used automatically.
# GEMINI_EXTRACT_MODEL="gemini-3-flash-preview,gemini-2.5-flash,gemini-3.1-pro-preview"
# GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
# Per-user hourly request limits for the AI endpoints:
# (Large PDFs use one extract request per 8 pages and one voice request per ~3,000 characters.)
# RATE_LIMIT_EXTRACT_PER_HOUR=300
# RATE_LIMIT_CLEANUP_PER_HOUR=60
# RATE_LIMIT_TTS_PER_HOUR=1500
